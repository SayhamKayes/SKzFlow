# ==============================================================================
# PROJECTFLOW AGENCY MANAGEMENT & GOOGLE SHEETS ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Google Sheets Webhook URL (Recommended & Easiest Setup)
# Deploy the provided Google Apps Script in your Google Sheet (Extensions > Apps Script > Deploy as Web App).
# Set 'Execute as: Me' and 'Who has access: Anyone'.
# Paste the resulting Web App URL below:
VITE_GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYED_SCRIPT_ID/exec"

# 2. Google Spreadsheet ID
# Find this in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
VITE_GOOGLE_SHEET_ID="your_google_sheet_id_here"

# 3. Optional: Google OAuth2 Client ID (For Google Identity Services)
VITE_GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
VITE_GOOGLE_API_KEY="your_google_api_key"

# 4. Gemini AI API Key (For optional AI analytics & summaries)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 5. App URL
VITE_APP_URL="http://localhost:5173"
